# ============================================================
#  Outreach Engine — Configuration File
#  Copy this file to .env and fill in YOUR values.
#  NEVER share your .env file with anyone.
# ============================================================

# --- REQUIRED ---

# Your Google Gemini API Key (free at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Your first name — used in message signatures (e.g. Chidi, Timi, Emeka)
SENDER_NAME=YourFirstName

# The product/company you are promoting (e.g. CoreCV, MyStartup, TechApp)
PRODUCT_NAME=YourProductName

# --- OPTIONAL (Messages auto-built if left blank) ---

# Custom intro line for HR messages (what you/your product does, 1 sentence)
# Example: building a career intelligence platform that helps professionals get hired faster
PRODUCT_INTRO=building a tool that helps professionals stand out and get hired faster

# Custom intro line for Candidate messages (1 sentence describing the product value)
# Example: helping professionals build credibility and unlock better opportunities
CANDIDATE_VALUE_PROP=helping professionals build credibility and unlock better job opportunities
